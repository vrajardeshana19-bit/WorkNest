# Application
APP_NAME=WorkNest
APP_ENV=development
DEBUG=true

# PostgreSQL (Neon) — use postgresql+psycopg2 driver for SQLAlchemy
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Optional: isolated PostgreSQL database for pytest (recommended)
TEST_DATABASE_URL=postgresql+psycopg2://user:password@host/dbname_test?sslmode=require

# JWT — no real secrets here; set in your local .env only
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — frontend dev server
FRONTEND_URL=http://localhost:5173

# Email verification — console logs tokens in development
EMAIL_PROVIDER=console
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Attendance — standard work day for extra-hours calculation (mockup default: 8h)
STANDARD_WORK_HOURS_PER_DAY=8
