# Application
APP_NAME=WorkNest
APP_ENV=development
DEBUG=true

# PostgreSQL (Neon) — use postgresql+psycopg2 driver for SQLAlchemy
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Optional: isolated PostgreSQL database for pytest (recommended)
TEST_DATABASE_URL=postgresql+psycopg2://user:password@host/dbname_test?sslmode=require

# JWT — no real secrets here; set in your local .env only
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — frontend dev server
FRONTEND_URL=http://localhost:5173

# Email — console (dev logs) or brevo (real delivery via Brevo API)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=worknestttt@gmail.com
BREVO_SENDER_NAME=WorkNest HRMS
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Attendance — standard work day for extra-hours calculation (mockup default: 8h)
STANDARD_WORK_HOURS_PER_DAY=8

# Brevo setup (https://app.brevo.com)
# 1. Create an API key under SMTP & API → API Keys
# 2. Verify sender under Senders & Domains (must match BREVO_SENDER_EMAIL)
# 3. Set EMAIL_PROVIDER=brevo and restart backend
